    <!-- Génération dynamique de l'icône Web App (512x512) et du manifest.json -->
    <script>
        (function generateUtileAppIcon() {
            try {
                const canvas = document.createElement('canvas');
                canvas.width = 512;
                canvas.height = 512;
                const ctx = canvas.getContext('2d');

                // Fond alpin dégradé bleu nuit vers bleu glacier
                const bgGrad = ctx.createLinearGradient(0, 0, 0, 512);
                bgGrad.addColorStop(0, '#0F2942');
                bgGrad.addColorStop(0.65, '#163A5C');
                bgGrad.addColorStop(1, '#1E4E79');
                ctx.fillStyle = bgGrad;
                ctx.fillRect(0, 0, 512, 512);

                // Montagnes enneigées en arrière-plan
                ctx.fillStyle = '#2B5B84';
                ctx.beginPath();
                ctx.moveTo(0, 350);
                ctx.lineTo(130, 210);
                ctx.lineTo(255, 315);
                ctx.lineTo(390, 195);
                ctx.lineTo(512, 330);
                ctx.lineTo(512, 512);
                ctx.lineTo(0, 512);
                ctx.closePath();
                ctx.fill();

                // Sommets enneigés blancs
                ctx.fillStyle = '#FFFFFF';
                ctx.beginPath();
                ctx.moveTo(130, 210);
                ctx.lineTo(95, 250);
                ctx.lineTo(118, 244);
                ctx.lineTo(133, 258);
                ctx.lineTo(152, 243);
                ctx.lineTo(168, 252);
                ctx.closePath();
                ctx.fill();

                ctx.beginPath();
                ctx.moveTo(390, 195);
                ctx.lineTo(348, 240);
                ctx.lineTo(375, 232);
                ctx.lineTo(392, 248);
                ctx.lineTo(414, 232);
                ctx.lineTo(435, 242);
                ctx.closePath();
                ctx.fill();

                // Manteau neigeux inférieur
                ctx.fillStyle = '#F4F9FD';
                ctx.beginPath();
                ctx.moveTo(0, 365);
                ctx.quadraticCurveTo(256, 325, 512, 360);
                ctx.lineTo(512, 512);
                ctx.lineTo(0, 512);
                ctx.closePath();
                ctx.fill();

                // Arc turquoise Utile autour du U
                ctx.strokeStyle = '#39B5A8';
                ctx.lineWidth = 22;
                ctx.lineCap = 'round';
                ctx.beginPath();
                ctx.arc(256, 195, 132, Math.PI * 0.78, Math.PI * 2.22);
                ctx.stroke();

                // Tracé du grand U (moitié haute blanche, moitié basse rouge savoyard)
                ctx.save();
                ctx.beginPath();
                ctx.moveTo(196, 125);
                ctx.lineTo(234, 125);
                ctx.lineTo(234, 196);
                ctx.quadraticCurveTo(234, 222, 256, 222);
                ctx.quadraticCurveTo(278, 222, 278, 196);
                ctx.lineTo(278, 125);
                ctx.lineTo(316, 125);
                ctx.lineTo(316, 198);
                ctx.quadraticCurveTo(316, 260, 256, 260);
                ctx.quadraticCurveTo(196, 260, 196, 198);
                ctx.closePath();
                ctx.clip();

                ctx.fillStyle = '#FFFFFF';
                ctx.fillRect(180, 115, 160, 72);

                ctx.fillStyle = '#C8232C';
                ctx.beginPath();
                ctx.moveTo(180, 182);
                ctx.quadraticCurveTo(220, 172, 256, 184);
                ctx.quadraticCurveTo(292, 194, 340, 180);
                ctx.lineTo(340, 270);
                ctx.lineTo(180, 270);
                ctx.closePath();
                ctx.fill();
                ctx.restore();

                // Contour net du U
                ctx.strokeStyle = '#0F2942';
                ctx.lineWidth = 5;
                ctx.beginPath();
                ctx.moveTo(196, 125);
                ctx.lineTo(234, 125);
                ctx.lineTo(234, 196);
                ctx.quadraticCurveTo(234, 222, 256, 222);
                ctx.quadraticCurveTo(278, 222, 278, 196);
                ctx.lineTo(278, 125);
                ctx.lineTo(316, 125);
                ctx.lineTo(316, 198);
                ctx.quadraticCurveTo(316, 260, 256, 260);
                ctx.quadraticCurveTo(196, 260, 196, 198);
                ctx.closePath();
                ctx.stroke();

                // Texte "Utile"
                ctx.fillStyle = '#0F2942';
                ctx.font = '800 54px sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText('Utile', 256, 412);

                // Sous-titre "La Norma"
                ctx.fillStyle = '#1E7D73';
                ctx.font = 'italic 800 36px sans-serif';
                ctx.fillText('La Norma', 256, 458);

                const iconDataUrl = canvas.toDataURL('image/png');
                window.__UTILE_ICON_URL__ = iconDataUrl;

                // Injection <link rel="icon"> et <link rel="apple-touch-icon">
                const favicon = document.createElement('link');
                favicon.rel = 'icon';
                favicon.type = 'image/png';
                favicon.href = iconDataUrl;
                document.head.appendChild(favicon);

                const appleIcon = document.createElement('link');
                appleIcon.rel = 'apple-touch-icon';
                appleIcon.href = iconDataUrl;
                document.head.appendChild(appleIcon);

                // Création du manifest.json dynamique en data-URI
                const manifestObj = {
                    name: 'Utile La Norma — Fondues & Raclettes',
                    short_name: 'Utile La Norma',
                    start_url: '.',
                    display: 'standalone',
                    background_color: '#F4F9FD',
                    theme_color: '#163A5C',
                    icons: [
                        {
                            src: iconDataUrl,
                            sizes: '512x512',
                            type: 'image/png',
                            purpose: 'any maskable'
                        }
                    ]
                };
                const manifestHref = 'data:application/manifest+json;charset=utf-8,' + encodeURIComponent(JSON.stringify(manifestObj));
                const manifestLink = document.createElement('link');
                manifestLink.rel = 'manifest';
                manifestLink.href = manifestHref;
                document.head.appendChild(manifestLink);
            } catch (e) {
                console.warn('Génération icône Web App ignorée :', e);
            }
        })();
    </script>

