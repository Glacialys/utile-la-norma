    <!-- LOGIQUE JAVASCRIPT COMPLÈTE -->
    <script>
        const STORAGE_KEY_ORDERS = 'utile_lanorma_orders_v3';
        const STORAGE_KEY_SETTINGS = 'utile_lanorma_settings_v3';

        const state = {
            quantities: {
                fondue: 0,
                fondueGourmande: 0,
                raclette: 0,
                racletteMixte: 0
            },
            selectedDate: '',
            selectedService: 'Midi',
            orders: [],
            settings: {
                brandName: 'Utile La Norma',
                whatsappTarget: '',
                pin: '1234'
            }
        };

        const PRICES = {
            fondue: 6,
            fondueGourmande: 9,
            raclette: 11,
            racletteMixte: 11
        };

        const DAYS_FR = ['Dimanche', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'];
        const MONTHS_FR = ['janv.', 'févr.', 'mars', 'avr.', 'mai', 'juin', 'juil.', 'août', 'sept.', 'oct.', 'nov.', 'déc.'];

        // Initialisation globale
        window.addEventListener('DOMContentLoaded', () => {
            loadSettings();
            loadOrders();
            renderWeeklyProgram();
            renderSelectableDays();
            updateTotalsUI();
            initQrCode();
            initInstallIconPreview();
        });

        function initInstallIconPreview() {
            const preview = document.getElementById('installIconPreview');
            if (preview && window.__UTILE_ICON_URL__) {
                preview.src = window.__UTILE_ICON_URL__;
            }
        }

        function openInstallModal() {
            document.getElementById('installModal').classList.remove('hidden');
        }

        function closeInstallModal() {
            document.getElementById('installModal').classList.add('hidden');
        }

        function loadSettings() {
            try {
                const saved = JSON.parse(localStorage.getItem(STORAGE_KEY_SETTINGS));
                if (saved) {
                    state.settings = { ...state.settings, ...saved };
                }
            } catch (e) {}
            document.getElementById('headerBrandName').textContent = state.settings.brandName || 'Utile La Norma';
            document.getElementById('settingBrandInput').value = state.settings.brandName || 'Utile La Norma';
            document.getElementById('settingWhatsappInput').value = state.settings.whatsappTarget || '';
            document.getElementById('settingPinInput').value = state.settings.pin || '1234';
        }

        function saveStoreSettings() {
            const brand = document.getElementById('settingBrandInput').value.trim() || 'Utile La Norma';
            const wa = document.getElementById('settingWhatsappInput').value.trim();
            const pin = document.getElementById('settingPinInput').value.trim() || '1234';

            state.settings = { brandName: brand, whatsappTarget: wa, pin: pin };
            localStorage.setItem(STORAGE_KEY_SETTINGS, JSON.stringify(state.settings));
            document.getElementById('headerBrandName').textContent = brand;
            showFeedback('Paramètres enregistrés avec succès.', 'success');
        }

        function loadOrders() {
            try {
                const saved = JSON.parse(localStorage.getItem(STORAGE_KEY_ORDERS));
                if (Array.isArray(saved)) {
                    state.orders = saved;
                }
            } catch (e) {
                state.orders = [];
            }
        }

        function saveOrders() {
            localStorage.setItem(STORAGE_KEY_ORDERS, JSON.stringify(state.orders));
        }

        function formatDateISO(dateObj) {
            const y = dateObj.getFullYear();
            const m = String(dateObj.getMonth() + 1).padStart(2, '0');
            const d = String(dateObj.getDate()).padStart(2, '0');
            return `${y}-${m}-${d}`;
        }

        function formatDateReadable(isoStr) {
            const parts = isoStr.split('-');
            if (parts.length !== 3) return isoStr;
            const d = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]));
            return `${DAYS_FR[d.getDay()]} ${d.getDate()} ${MONTHS_FR[d.getMonth()]}`;
        }

        // Programme hebdomadaire du lundi au dimanche
        function renderWeeklyProgram() {
            const grid = document.getElementById('weeklyProgramGrid');
            const todayIndex = new Date().getDay();
            const orderedDays = [
                { dayIdx: 1, name: 'Lundi', info: 'Midi & Soir • Retrait magasin' },
                { dayIdx: 2, name: 'Mardi', info: 'Midi & Soir • Retrait magasin' },
                { dayIdx: 3, name: 'Mercredi', info: 'Midi & Soir • Retrait magasin' },
                { dayIdx: 4, name: 'Jeudi', info: 'Midi & Soir • Retrait magasin' },
                { dayIdx: 5, name: 'Vendredi', info: 'Midi & Soir • Retrait magasin' },
                { dayIdx: 6, name: 'Samedi', info: 'Midi & Soir • Retrait magasin' },
                { dayIdx: 0, name: 'Dimanche', info: 'Midi & Soir • Retrait magasin' }
            ];

            grid.innerHTML = orderedDays.map(item => {
                const isToday = item.dayIdx === todayIndex;
                return `
                    <div class="p-3.5 rounded-2xl border ${isToday ? 'border-savoy-red bg-red-50/40' : 'border-alpine-200 bg-alpine-50/50'} flex flex-col justify-between">
                        <div class="flex items-center justify-between">
                            <span class="font-bold text-sm text-alpine-900">${item.name}</span>
                            ${isToday ? '<span class="px-2 py-0.5 rounded-full bg-savoy-red text-white text-[10px] font-bold">Aujourd\'hui</span>' : ''}
                        </div>
                        <p class="text-xs text-alpine-700 mt-1">${item.info}</p>
                        <p class="text-[11px] font-semibold text-savoy-tealDark mt-1">
                            ${isToday ? 'Réservation dès demain' : 'Disponible à la réservation'}
                        </p>
                    </div>
                `;
            }).join('');
        }

        // Rendu des jours sélectionnables (Jour même bloqué + 7 prochains jours ouverts)
        function renderSelectableDays() {
            const container = document.getElementById('daysContainer');
            const today = new Date();
            let html = '';

            // Carte Aujourd'hui bloquée
            html += `
                <div class="p-3 rounded-2xl border border-slate-200 bg-slate-100 opacity-75 cursor-not-allowed select-none flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-extrabold text-slate-600">${DAYS_FR[today.getDay()]}</span>
                        <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-slate-300 text-slate-700">Fermé J-0</span>
                    </div>
                    <p class="text-sm font-bold text-slate-500 mt-1">${today.getDate()} ${MONTHS_FR[today.getMonth()]}</p>
                    <p class="text-[11px] text-slate-500 mt-0.5">Pas le jour même</p>
                </div>
            `;

            // 7 prochains jours à partir de demain
            for (let i = 1; i <= 7; i++) {
                const futureDate = new Date(today);
                futureDate.setDate(today.getDate() + i);
                const iso = formatDateISO(futureDate);
                if (i === 1 && !state.selectedDate) {
                    state.selectedDate = iso;
                }
                const isSelected = state.selectedDate === iso;
                html += `
                    <button type="button" onclick="selectDate('${iso}')" class="day-card-btn p-3 rounded-2xl border-2 text-left transition cursor-pointer flex flex-col justify-between ${isSelected ? 'border-savoy-red bg-red-50/70 shadow-xs' : 'border-alpine-200 bg-white hover:border-alpine-400'}">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-extrabold ${isSelected ? 'text-savoy-red' : 'text-alpine-700'}">${DAYS_FR[futureDate.getDay()]}</span>
                            ${i === 1 ? '<span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800">Demain</span>' : ''}
                        </div>
                        <p class="text-sm font-extrabold text-alpine-900 mt-1">${futureDate.getDate()} ${MONTHS_FR[futureDate.getMonth()]}</p>
                        <p class="text-[11px] font-medium text-alpine-700 mt-0.5">Midi ou Soir</p>
                    </button>
                `;
            }

            container.innerHTML = html;
            document.getElementById('selectedDateInput').value = state.selectedDate;
        }

        function selectDate(iso) {
            state.selectedDate = iso;
            renderSelectableDays();
        }

        function selectService(service) {
            state.selectedService = service;
            document.getElementById('selectedServiceInput').value = service;
            const midiBtn = document.getElementById('slotMidiBtn');
            const soirBtn = document.getElementById('slotSoirBtn');

            if (service === 'Midi') {
                midiBtn.className = 'service-btn p-3.5 rounded-2xl border-2 border-savoy-red bg-red-50/60 text-alpine-900 font-bold text-sm flex flex-col items-center justify-center gap-0.5 transition cursor-pointer';
                soirBtn.className = 'service-btn p-3.5 rounded-2xl border-2 border-alpine-200 bg-white text-alpine-800 font-bold text-sm flex flex-col items-center justify-center gap-0.5 transition cursor-pointer';
            } else {
                soirBtn.className = 'service-btn p-3.5 rounded-2xl border-2 border-savoy-red bg-red-50/60 text-alpine-900 font-bold text-sm flex flex-col items-center justify-center gap-0.5 transition cursor-pointer';
                midiBtn.className = 'service-btn p-3.5 rounded-2xl border-2 border-alpine-200 bg-white text-alpine-800 font-bold text-sm flex flex-col items-center justify-center gap-0.5 transition cursor-pointer';
            }
        }

        function quickSelectFormule(type) {
            updateQty(type, 1);
            document.getElementById('reservation').scrollIntoView({ behavior: 'smooth' });
        }

        function updateQty(type, delta) {
            const next = Math.max(0, (state.quantities[type] || 0) + delta);
            state.quantities[type] = next;
            document.getElementById(`${type}QtyDisplay`).textContent = next;
            updateTotalsUI();
        }

        function calculateOrderTotal(q) {
            return (q.fondue * PRICES.fondue) +
                   (q.fondueGourmande * PRICES.fondueGourmande) +
                   (q.raclette * PRICES.raclette) +
                   (q.racletteMixte * PRICES.racletteMixte);
        }

        function updateTotalsUI() {
            const total = calculateOrderTotal(state.quantities);
            document.getElementById('totalPriceDisplay').textContent = `${total} €`;
        }

        function showFeedback(message, type) {
            const box = document.getElementById('formFeedbackBox');
            box.textContent = message;
            box.classList.remove('hidden', 'bg-red-100', 'text-savoy-redDark', 'bg-emerald-100', 'text-emerald-900');
            if (type === 'error') {
                box.classList.add('bg-red-100', 'text-savoy-redDark');
            } else {
                box.classList.add('bg-emerald-100', 'text-emerald-900');
            }
        }

        function buildOrderPayload() {
            const name = document.getElementById('clientNameInput').value.trim();
            const phone = document.getElementById('clientPhoneInput').value.trim();
            const totalPersons = state.quantities.fondue + state.quantities.fondueGourmande + state.quantities.raclette + state.quantities.racletteMixte;

            if (!state.selectedDate) {
                showFeedback('Veuillez sélectionner un jour de retrait.', 'error');
                return null;
            }
            if (totalPersons <= 0) {
                showFeedback('Veuillez ajouter au moins 1 personne sur une formule Fondue ou Raclette.', 'error');
                return null;
            }
            if (!name || !phone) {
                showFeedback('Veuillez renseigner votre nom et votre numéro de téléphone.', 'error');
                return null;
            }

            return {
                id: 'CMD-' + Date.now(),
                date: state.selectedDate,
                service: state.selectedService,
                quantities: { ...state.quantities },
                loanFondue: document.getElementById('loanFondueCheckbox').checked,
                loanRaclette: document.getElementById('loanRacletteCheckbox').checked,
                clientName: name,
                clientPhone: phone,
                totalPrice: calculateOrderTotal(state.quantities),
                prepared: false,
                createdAt: new Date().toISOString()
            };
        }

        // Soumission du formulaire de réservation
        document.getElementById('bookingForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const order = buildOrderPayload();
            if (!order) return;

            state.orders.push(order);
            saveOrders();
            renderKitchenDashboard();

            showFeedback(`Merci ${order.clientName} ! Votre réservation pour le ${formatDateReadable(order.date)} (${order.service}) est enregistrée (${order.totalPrice} €).`, 'success');

            // Réinitialisation des compteurs
            state.quantities = { fondue: 0, fondueGourmande: 0, raclette: 0, racletteMixte: 0 };
            ['fondue', 'fondueGourmande', 'raclette', 'racletteMixte'].forEach(k => {
                document.getElementById(`${k}QtyDisplay`).textContent = '0';
            });
            document.getElementById('loanFondueCheckbox').checked = false;
            document.getElementById('loanRacletteCheckbox').checked = false;
            updateTotalsUI();
        });

        // Envoi vers le groupe WhatsApp dédié (sans exposer de numéro personnel)
        function sendReservationViaWhatsApp() {
            const order = buildOrderPayload();
            if (!order) return;

            // Enregistrer également dans le suivi cuisine si pas encore enregistré
            state.orders.push(order);
            saveOrders();
            renderKitchenDashboard();

            const lines = [
                `*NOUVELLE RÉSERVATION — ${state.settings.brandName}*`,
                `Date : *${formatDateReadable(order.date)}* (${order.service})`,
                `Client : *${order.clientName}* (${order.clientPhone})`,
                `---`
            ];
            if (order.quantities.fondue > 0) lines.push(`• La Fondue (6€) : ${order.quantities.fondue} pers.`);
            if (order.quantities.fondueGourmande > 0) lines.push(`• La Fondue Gourmande (9€) : ${order.quantities.fondueGourmande} pers.`);
            if (order.quantities.raclette > 0) lines.push(`• La Raclette (11€) : ${order.quantities.raclette} pers.`);
            if (order.quantities.racletteMixte > 0) lines.push(`• Raclette Mixte (11€) : ${order.quantities.racletteMixte} pers.`);
            if (order.loanFondue) lines.push(`• Prêt appareil à fondue : OUI`);
            if (order.loanRaclette) lines.push(`• Prêt appareil à raclette : OUI`);
            lines.push(`Total magasin : *${order.totalPrice} €*`);

            const messageText = lines.join('\n');

            // Copier le récapitulatif dans le presse-papiers
            try {
                const tempArea = document.createElement('textarea');
                tempArea.value = messageText;
                document.body.appendChild(tempArea);
                tempArea.select();
                document.execCommand('copy');
                document.body.removeChild(tempArea);
            } catch (err) {}

            const target = (state.settings.whatsappTarget || '').trim();
            if (target.startsWith('http://') || target.startsWith('https://')) {
                showFeedback('Récapitulatif copié ! Ouverture de votre groupe WhatsApp dédié (faites « Coller » dans la discussion).', 'success');
                window.open(target, '_blank', 'noopener');
            } else if (target.replace(/\D/g, '').length >= 8) {
                const cleanNum = target.replace(/\D/g, '');
                window.open(`https://wa.me/${cleanNum}?text=${encodeURIComponent(messageText)}`, '_blank', 'noopener');
            } else {
                window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(messageText)}`, '_blank', 'noopener');
            }
        }

        // Espace Cuisine / Préparations
        function toggleKitchenAccess() {
            const pinBox = document.getElementById('kitchenPinBox');
            pinBox.classList.toggle('hidden');
        }

        function verifyKitchenPin() {
            const entered = document.getElementById('kitchenPinInput').value.trim();
            const errorEl = document.getElementById('pinErrorText');
            if (entered === (state.settings.pin || '1234')) {
                errorEl.classList.add('hidden');
                document.getElementById('kitchenPinBox').classList.add('hidden');
                document.getElementById('kitchenDashboard').classList.remove('hidden');
                populateKitchenDateFilter();
                renderKitchenDashboard();
            } else {
                errorEl.classList.remove('hidden');
            }
        }

        function closeKitchenDashboard() {
            document.getElementById('kitchenDashboard').classList.add('hidden');
        }

        function populateKitchenDateFilter() {
            const select = document.getElementById('kitchenDateFilter');
            const uniqueDates = [...new Set(state.orders.map(o => o.date))].sort();
            let options = '<option value="ALL">Tous les jours enregistrés</option>';
            uniqueDates.forEach(d => {
                options += `<option value="${d}">${formatDateReadable(d)}</option>`;
            });
            select.innerHTML = options;
        }

        function toggleOrderPrepared(orderId) {
            const target = state.orders.find(o => o.id === orderId);
            if (target) {
                target.prepared = !target.prepared;
                saveOrders();
                renderKitchenDashboard();
            }
        }

        function deleteOrder(orderId) {
            state.orders = state.orders.filter(o => o.id !== orderId);
            saveOrders();
            populateKitchenDateFilter();
            renderKitchenDashboard();
        }

        function renderKitchenDashboard() {
            const dateFilter = document.getElementById('kitchenDateFilter').value;
            const serviceFilter = document.getElementById('kitchenServiceFilter').value;

            const filtered = state.orders.filter(o => {
                const matchDate = dateFilter === 'ALL' || o.date === dateFilter;
                const matchService = serviceFilter === 'ALL' || o.service === serviceFilter;
                return matchDate && matchService;
            });

            // Calcul des besoins exacts en préparation
            let totalFonduePers = 0;
            let totalFondueGourmandePers = 0;
            let totalRaclettePers = 0;
            let totalRacletteMixtePers = 0;
            let fondueDevices = 0;
            let racletteDevices = 0;

            filtered.forEach(o => {
                totalFonduePers += (o.quantities.fondue || 0);
                totalFondueGourmandePers += (o.quantities.fondueGourmande || 0);
                totalRaclettePers += (o.quantities.raclette || 0);
                totalRacletteMixtePers += (o.quantities.racletteMixte || 0);
                if (o.loanFondue) fondueDevices += 1;
                if (o.loanRaclette) racletteDevices += 1;
            });

            // Base standard 200g fromage / pers. pour la fondue (50% Beaufort, 25% Montagnard, 25% Comté)
            const allFonduePers = totalFonduePers + totalFondueGourmandePers;
            const beaufortGrams = allFonduePers * 100;
            const montagnardGrams = allFonduePers * 50;
            const comteGrams = allFonduePers * 50;

            // Fromages raclette
            const racletteSavoieGrams = totalRaclettePers * 200;
            const racletteNatureGrams = totalRacletteMixtePers * 100;
            const racletteFumeeGrams = totalRacletteMixtePers * 50;
            const racletteAilOursGrams = totalRacletteMixtePers * 50;

            // Charcuteries (tranches)
            const allRaclettePers = totalRaclettePers + totalRacletteMixtePers;
            const slicesJambonBlanc = allRaclettePers * 1;
            const slicesJambonSec = allRaclettePers * 1;
            const slicesGrisons = allRaclettePers * 2;
            const slicesRosette = (allRaclettePers + totalFondueGourmandePers) * 2;
            const slicesBacon = (allRaclettePers + totalFondueGourmandePers) * 2;
            const slicesCoppa = (allRaclettePers + totalFondueGourmandePers) * 2;
            const slicesPaveCepe = totalFondueGourmandePers * 2;
            const slicesPavePiment = totalFondueGourmandePers * 2;

            document.getElementById('prepSummaryCards').innerHTML = `
                <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200 space-y-1.5">
                    <h4 class="font-extrabold text-amber-950 text-sm">Fromages à préparer</h4>
                    <p class="text-xs text-amber-900">• Beaufort (Fondue) : <strong>${beaufortGrams} g</strong></p>
                    <p class="text-xs text-amber-900">• Montagnard (Fondue) : <strong>${montagnardGrams} g</strong></p>
                    <p class="text-xs text-amber-900">• Comté (Fondue) : <strong>${comteGrams} g</strong></p>
                    <hr class="border-amber-200 my-1">
                    <p class="text-xs text-amber-900">• Raclette de Savoie : <strong>${racletteSavoieGrams} g</strong></p>
                    <p class="text-xs text-amber-900">• Raclette Nature lait cru : <strong>${racletteNatureGrams} g</strong></p>
                    <p class="text-xs text-amber-900">• Raclette Fumée lait cru : <strong>${racletteFumeeGrams} g</strong></p>
                    <p class="text-xs text-amber-900">• Raclette Ail des ours : <strong>${racletteAilOursGrams} g</strong></p>
                </div>

                <div class="p-4 rounded-2xl bg-red-50 border border-red-200 space-y-1.5">
                    <h4 class="font-extrabold text-savoy-redDark text-sm">Charcuteries (tranches)</h4>
                    <p class="text-xs text-alpine-900">• Jambon blanc : <strong>${slicesJambonBlanc} tr.</strong></p>
                    <p class="text-xs text-alpine-900">• Jambon sec de Savoie : <strong>${slicesJambonSec} tr.</strong></p>
                    <p class="text-xs text-alpine-900">• Rosette : <strong>${slicesRosette} tr.</strong></p>
                    <p class="text-xs text-alpine-900">• Bacon de Savoie : <strong>${slicesBacon} tr.</strong></p>
                    <p class="text-xs text-alpine-900">• Coppa de Savoie : <strong>${slicesCoppa} tr.</strong></p>
                    <p class="text-xs text-alpine-900">• Viande des Grisons : <strong>${slicesGrisons} tr.</strong></p>
                    <p class="text-xs text-alpine-900">• Pavé au cèpe : <strong>${slicesPaveCepe} tr.</strong></p>
                    <p class="text-xs text-alpine-900">• Pavé au piment : <strong>${slicesPavePiment} tr.</strong></p>
                </div>

                <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 space-y-1.5">
                    <h4 class="font-extrabold text-emerald-950 text-sm">Pain & Prêts d'appareils</h4>
                    <p class="text-xs text-emerald-900">• Baguette coupée en cubes (offerte) : <strong>${allFonduePers} parts</strong></p>
                    <hr class="border-emerald-200 my-1">
                    <p class="text-xs text-emerald-900">• Appareils à fondue à prêter : <strong>${fondueDevices}</strong></p>
                    <p class="text-xs text-emerald-900">• Appareils à raclette à prêter : <strong>${racletteDevices}</strong></p>
                </div>
            `;

            const listContainer = document.getElementById('kitchenOrdersList');
            if (filtered.length === 0) {
                listContainer.innerHTML = `<p class="text-xs text-alpine-700 bg-alpine-50 p-4 rounded-2xl">Aucune réservation enregistrée pour ce filtre.</p>`;
                return;
            }

            listContainer.innerHTML = filtered.map(o => {
                const details = [];
                if (o.quantities.fondue) details.push(`${o.quantities.fondue} Fondue`);
                if (o.quantities.fondueGourmande) details.push(`${o.quantities.fondueGourmande} Fondue Gourmande`);
                if (o.quantities.raclette) details.push(`${o.quantities.raclette} Raclette`);
                if (o.quantities.racletteMixte) details.push(`${o.quantities.racletteMixte} Raclette Mixte`);
                if (o.loanFondue) details.push('Prêt appareil fondue');
                if (o.loanRaclette) details.push('Prêt appareil raclette');

                return `
                    <div class="p-4 rounded-2xl border ${o.prepared ? 'bg-emerald-50/70 border-emerald-300' : 'bg-alpine-50 border-alpine-200'} flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <div>
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="font-extrabold text-sm text-alpine-900">${o.clientName}</span>
                                <span class="text-xs font-semibold text-alpine-700">(${o.clientPhone})</span>
                                <span class="px-2 py-0.5 rounded-lg bg-alpine-900 text-white text-[11px] font-bold">${formatDateReadable(o.date)} • ${o.service}</span>
                                <span class="font-extrabold text-xs text-savoy-red">${o.totalPrice} €</span>
                            </div>
                            <p class="text-xs text-alpine-800 mt-1">${details.join(' • ')}</p>
                        </div>
                        <div class="flex items-center gap-2 no-print shrink-0">
                            <button type="button" onclick="toggleOrderPrepared('${o.id}')" class="px-3 py-1.5 rounded-xl text-xs font-bold cursor-pointer ${o.prepared ? 'bg-emerald-700 text-white' : 'bg-white border border-alpine-300 text-alpine-900'}">
                                ${o.prepared ? 'Préparée ✓' : 'Marquer préparée'}
                            </button>
                            <button type="button" onclick="deleteOrder('${o.id}')" class="px-2.5 py-1.5 rounded-xl bg-red-100 text-savoy-redDark text-xs font-bold cursor-pointer">
                                Suppr.
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // QR Code
        function renderQrCodeWithUrl(targetUrl) {
            const container = document.getElementById('qrcodeContainer');
            const label = document.getElementById('qrActiveUrlText');
            const cleanUrl = (targetUrl || window.location.href).trim();
            container.innerHTML = '';
            new QRCode(container, {
                text: cleanUrl,
                width: 210,
                height: 210,
                colorDark: '#163A5C',
                colorLight: '#FFFFFF',
                correctLevel: QRCode.CorrectLevel.H
            });
            if (label) label.textContent = cleanUrl;
        }

        function initQrCode() {
            const input = document.getElementById('qrCustomUrlInput');
            const defaultUrl = window.location.href.startsWith('http') ? window.location.href : 'https://utile-lanorma-fondue.netlify.app';
            if (input) input.value = defaultUrl;
            renderQrCodeWithUrl(defaultUrl);
        }

        function updateQrCodeFromInput() {
            const input = document.getElementById('qrCustomUrlInput');
            if (!input || !input.value.trim()) return;
            renderQrCodeWithUrl(input.value.trim());
        }

        function openQrModal() {
            document.getElementById('qrModal').classList.remove('hidden');
        }

        function closeQrModal() {
            document.getElementById('qrModal').classList.add('hidden');
        }

        function downloadQrCode() {
            const canvas = document.querySelector('#qrcodeContainer canvas');
            const img = document.querySelector('#qrcodeContainer img');
            const dataUrl = canvas ? canvas.toDataURL('image/png') : (img ? img.src : '');
            if (!dataUrl) return;
            const link = document.createElement('a');
            link.href = dataUrl;
            link.download = 'qr-code-utile-la-norma.png';
            link.click();
        }
    </script>
</body>
</html>
